:80 {

    header {
        # Force HTTPS for 1 year, include subdomains, allow preloading
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"

        # Prevent MIME-type sniffing
        X-Content-Type-Options "nosniff"

        # Basic XSS protection (legacy browsers)
        X-XSS-Protection "1; mode=block"

        # Control referrer information
        Referrer-Policy "strict-origin-when-cross-origin"

        # Restrict browser features
        Permissions-Policy "camera=(), microphone=(), geolocation=()"

        # Remove Server header (don't expose Caddy version)
        -Server
    }

    # ── Health check endpoint (no rate-limit, no logs) ───────────────────────
    handle /health {
        reverse_proxy api:8080 {
            header_up Host              {host}
            header_up X-Real-IP         {remote_host}
            header_up X-Forwarded-For   {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ── AI API routes ────────────────────────────────────────────────────────
    handle_path /ai/* {
        reverse_proxy ai_api:8000 {
            header_up Host              {host}
            header_up X-Real-IP         {remote_host}
            header_up X-Forwarded-For   {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ── API routes ────────────────────────────────────────────────────────────
    handle /api/* {

        reverse_proxy api:8080 {
            header_up Host              {host}
            header_up X-Real-IP         {remote_host}
            header_up X-Forwarded-For   {remote_host}
            header_up X-Forwarded-Proto {scheme}

            # Passive health checks — mark backend unhealthy after 3 failures
            health_uri      /health
            health_interval 15s
            health_timeout  5s
            health_status   200

            # Timeouts
            transport http {
                read_timeout       60s
                write_timeout      60s
                response_header_timeout 30s
            }
        }
    }

    handle {
	reverse_proxy web:3000 {
	    header_up Host              {host}
	    header_up X-Real-IP         {remote_host}
	    header_up X-Forwarded-For   {remote_host}
	    header_up X-Forwarded-Proto {scheme}
	    transport http {
		read_timeout            30s
		write_timeout           30s
		response_header_timeout 15s
	    }
	}
    }


    # ── Structured access logging ─────────────────────────────────────────────
    log {
        output file /var/log/caddy/access.log {
            roll_size     50MB
            roll_keep     7
            roll_keep_for 720h   # 30 days
        }
        format json
        level  INFO
    }
}
