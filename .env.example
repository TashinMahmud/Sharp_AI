# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Memory Management Settings
MEMORY_SUMMARY_TRIGGER=10    # Trigger summarization after this many messages
MEMORY_KEEP_LAST=5            # Keep this many recent messages after pruning
MEMORY_MAX_TURNS=20           # Maximum turns to keep in short-term memory

# Application Settings
DEBUG=false
OPENAI_TIMEOUT=30
MAX_RETRIES=3
